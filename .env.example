# Copy this file to .env (gitignored) and fill in real values locally.
# Never commit real credentials — .env is already covered by the repo's .gitignore.

E2E_BASE_URL=https://dev.bcasapp.com/

# Agent dashboard user (lands on /dashboard)
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# Student with an active loan request (lands on /user/loan/...)
E2E_TEST_STUDENT_EMAIL=
E2E_TEST_STUDENT_PASSWORD=

# School admin agent of the SQA school (lands on /school-dashboard/<E2E_SQA_SCHOOL_ID>)
E2E_TEST_AGENT_EMAIL=
E2E_TEST_AGENT_PASSWORD=

# Backend URL. Optional against dev; required whenever E2E_BASE_URL points elsewhere, so test data
# is created in the same backend the web app reads from
# E2E_API_URL=https://dev-s.bcasapp.com/

# Optional: only needed outside dev, where the SQA school data differs
# E2E_SQA_SCHOOL_ID=345
# E2E_SQA_SCHOOL_NAME=SQA website testing
# E2E_SQA_COURSE_ID=752
